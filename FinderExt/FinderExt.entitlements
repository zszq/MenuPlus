<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
        Finder Sync Extension 必须启用 App Sandbox。
        但为了让扩展能够执行 killall Finder、创建文件等操作，
        需要开放必要的权限。

        注意：如果主 App 关闭了 sandbox（直接分发），
        Extension 仍需保持 sandbox=true（系统强制要求），
        但可以申请宽松权限。
    -->
    <key>com.apple.security.app-sandbox</key>
    <true/>

    <!-- 读取用户选择的文件/文件夹 -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>

    <!-- 允许写入下载目录（创建文件时可能需要） -->
    <key>com.apple.security.files.downloads.read-write</key>
    <true/>

    <!-- 允许发送 Apple Events（用于控制 Terminal） -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>

    <!-- 允许访问所有文件（需要在代码签名时申请，或使用 Hardened Runtime 豁免） -->
    <!-- 注意：com.apple.security.files.all 是受限权限，仅用于提示配置 -->
    <!-- <key>com.apple.security.files.all</key> -->
    <!-- <true/> -->
</dict>
</plist>
